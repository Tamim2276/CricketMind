.venv/
CricShot10k/
data/*
!data/splits*/
data/splits*/*
!data/splits*/*.csv
!data/splits*/*.json

# frame grids: 7.7 MB and regenerable with one command (src/data/viz.py)
notes/figures/*
# run figures are not regenerable once experiments/ is gone -- keep these
!notes/figures/runs/
# checkpoints are huge and regenerable. The evidence they produced is neither:
# history.json is the only per-epoch record, and report_*.json carries the
# per-class scores plus the checkpoint's sha256. 80 KB for both runs.
experiments/*/*
!experiments/*/history.json
!experiments/*/report_*.json
!experiments/results.jsonl
__pycache__/
*.pt
CricShoot10kModels/
*.keras
*.h5

# CricketMind v3 lives on its own branch (cricketmind-v3); ignored here so
# CricShot commits never pick it up
cricketmind-v3/

# LaTeX build files; the .tex and .pdf are what we keep
paper/*.aux
paper/*.log
paper/*.out
